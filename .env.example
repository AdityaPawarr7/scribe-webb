# Server-only. Never prefix with VITE_ or it ships to the browser.
CONCENTRATE_API_KEY=sk-cn-...
CONCENTRATE_BASE_URL=https://api.concentrate.ai/v1
CONCENTRATE_MODEL=gpt-oss-120b

# Rate limits (per anonymous session + global; tune later)
SCRIBE_DAILY_SUMMARIES_PER_IP=10
SCRIBE_GLOBAL_MONTHLY_SPEND_USD=20
